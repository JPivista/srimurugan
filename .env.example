# MongoDB Atlas. Used locally and on Vercel.
# Set the same variable in the Vercel project: Settings → Environment Variables.
MONGODB_URI=mongodb+srv://USER:PASSWORD@servhub.ljwh0vo.mongodb.net/srimurugan?retryWrites=true&w=majority&authSource=admin
MONGODB_DB=srimurugan

# Office login for /app (ledger, customers, bank). Required in production.
APP_USERNAME=admin
APP_PASSWORD=choose-a-long-password
# At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
